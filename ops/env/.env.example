# =====================================================
# RIFFLE – ENVIRONMENT CONFIGURATION TEMPLATE
# =====================================================
# Kullanım:
#   cp .env.example .env.dev   → geliştirme ortamı
#   cp .env.example .env.prod  → prodüksiyon ortamı
#
# Ortam modeli:
#   dev  → TLS yok, mTLS yok, devtools açık
#   prod → TLS + mTLS + Caddy + monitoring + backup
# =====================================================


# -----------------------------------------------------
# PROJECT
# -----------------------------------------------------
COMPOSE_PROJECT_NAME=riffle          # dev: riffle-dev | prod: riffle
DOCKER_STAGE=dev                     # dev | prod


# -----------------------------------------------------
# RUNTIME / APP
# -----------------------------------------------------
NODE_ENV=development                 # dev: development | prod: production
PORT=1968
JWT_SECRET=change_me                 # REQUIRED – güçlü bir secret kullan
CORS_ORIGIN=http://localhost:5173    # prod: https://yourdomain.com

RIFFLE_API_KEY=change_me             # REQUIRED
DEEZER_API_KEY=change_me             # REQUIRED


# -----------------------------------------------------
# CLIENT (VITE)
# -----------------------------------------------------
VITE_API_URL=http://localhost:1968   # prod: https://yourdomain.com/api
VITE_USE_MOCK=false


# -----------------------------------------------------
# INTERNAL SERVICES (Docker network DNS)
# -----------------------------------------------------
CORE_API_URL=http://service-core-api:1968
MATCHMAKER_URL=http://service-matchmaker:8080
# Used by core-api to proxy GET /api/matchmaker/lobbies → matchmaker GET /lobbies
MATCHMAKER_HTTP_URL=http://matchmaker:8080
STORE_SERVICE_URL=http://service-store:3000
MUSIC_SERVICE_URL=http://service-music:3000
WORKER_URL=http://service-worker:3000


# -----------------------------------------------------
# ZERO TRUST (mTLS)
# dev: false | prod: true
# -----------------------------------------------------
MTLS_ENABLED=false
MTLS_CA_PATH=/app/certs/ca.crt
MTLS_CERT_PATH=/app/certs/client.crt
MTLS_KEY_PATH=/app/certs/client.key


# -----------------------------------------------------
# DATABASE – POSTGRES
# dev: plain | prod: SSL komutunu ekle
# -----------------------------------------------------
POSTGRES_START_CMD=postgres
POSTGRES_HOST=store-game-pg
POSTGRES_PORT=5432
POSTGRES_DB=riffle_db
POSTGRES_USER=riffle_user
POSTGRES_PASSWORD=change_me          # REQUIRED
POSTGRES_SSL_MODE=disable            # prod: require


# -----------------------------------------------------
# CACHE – REDIS
# dev: plain TCP | prod: TLS startup komutu
# -----------------------------------------------------
REDIS_START_CMD=redis-server --port 6379 --aclfile /etc/redis/users.acl

GAME_REDIS_HOST=active-game-redis
GAME_REDIS_PORT=6379
GAME_REDIS_TLS=0                     # prod: 1


# -----------------------------------------------------
# WORKERS / TRANSPORT SECURITY
# -----------------------------------------------------
WORKER_DB_SSL=false                  # prod: true
WORKER_REDIS_TLS=false               # prod: true


# -----------------------------------------------------
# BACKUPS
# -----------------------------------------------------
BACKUP_SCHEDULE="0 3 * * *"
BACKUP_KEEP_DAYS=7
BACKUP_SSL_MODE=disable              # prod: require


# -----------------------------------------------------
# CADDY – sadece prod
# -----------------------------------------------------
DOMAIN=yourdomain.com
CADDY_EMAIL=admin@yourdomain.com


# -----------------------------------------------------
# MONITORING – sadece prod
# -----------------------------------------------------
GRAFANA_PASSWORD=change_me
