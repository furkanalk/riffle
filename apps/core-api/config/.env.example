# ── APPLICATION ──────────────────────────────────────────────────────────────
NODE_ENV=<dev|prod>
PORT=<port>

# ── DATABASE ──────────────────────────────────────────────────────────────────
POSTGRES_USER=riffle_user
POSTGRES_PASSWORD=<password>
POSTGRES_DB=riffle_<env>
POSTGRES_HOST=<host>
POSTGRES_PORT=<port>
DATABASE_URL=postgresql://riffle_user:<password>@<host>:<port>/riffle_<env>

# ── SECURITY ──────────────────────────────────────────────────────────────────
RIFFLE_API_KEY=<your_api_key>
JWT_SECRET=<your_jwt_secret>
TOKEN_EXPIRES_IN=1d

# ── CORS ──────────────────────────────────────────────────────────────────────
CORS_ORIGIN=<origin_url_or_*>
